# cp .env.example .env して使う。.env は git 管理外。

# Claude Code の認証（どちらか一方）
# - Pro / Max のサブスクリプションで使う：ホストで `claude setup-token` を実行して出たトークン
CLAUDE_CODE_OAUTH_TOKEN=
# - API キーで使う（従量課金）
# ANTHROPIC_API_KEY=

# 別の端末（スマホなど）から開くときのトークン。設定したら http://<PCのIP>:8765/?token=<これ> で開く
# LEARN_TOKEN=

# claude に渡す追加の引数（例：使うモデルを変える）
# LEARN_CLAUDE_ARGS=--model sonnet
