{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imohiyoko/learn/schema/ask-line.schema.json",
  "title": "log/asks.jsonl の1行",
  "description": "解答中の質問。web UI のサーバーが書く（記述の解答欄からと、セットを解いている途中の「わからない言葉」から）。",
  "type": "object",
  "required": [
    "id",
    "tags",
    "kind",
    "text",
    "asked_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "質問した問題の id（セットの途中なら問題バンクの id）"
    },
    "set": {
      "type": "string",
      "pattern": "^set-\\d{8}-\\d{6}(-\\d+)?$",
      "description": "セットを解いている途中の質問なら、そのセット"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "maxItems": 20,
      "description": "問題の分野タグ。空の行は分析に使わない"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$"
      },
      "description": "セットの問題の論点ID"
    },
    "part": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^設問\\d+(\\(\\d+\\))?$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "word",
        "ask",
        "worry"
      ],
      "description": "word 言葉の意味／ask 何を聞かれているか／worry 不安・その他"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "asked_at": {
      "type": "string",
      "format": "date-time",
      "description": "タイムゾーン付きの ISO 8601（RFC 3339）"
    }
  },
  "additionalProperties": false
}
